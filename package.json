{
	"name": "github-workflows",
	"private": true,
	"description": "Reusable GitHub Actions workflows and actions for Solidity and Foundry projects.",
	"author": "fomoweth",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm --recursive --if-present run build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "pnpm --recursive --if-present run test",
		"typecheck": "pnpm --recursive --if-present run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^25.4.0",
		"typescript": "^5.9.3"
	},
	"packageManager": "pnpm@10.25.0"
}
